function StarRating({ count }: { count: number }) {
  return (
    <div className="flex gap-1">
      {Array.from({ length: count }).map((_, i) => (
        <Star key={i} className="h-4 w-4 fill-[#D4AF37] text-[#D4AF37]" />
      ))}
    </div>
  );
}

export function Testimonials() {
